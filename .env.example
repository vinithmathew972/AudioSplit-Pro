# AudioSplit Pro Environment Configuration

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# File Upload Limit in Megabytes (Default: 500 MB)
MAX_UPLOAD_SIZE_MB=500

# Temporary File Retention in Seconds (Default: 3600 seconds = 1 hour)
JOB_RETENTION_SECONDS=3600

# Optional custom FFmpeg/FFprobe paths (if not in PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
